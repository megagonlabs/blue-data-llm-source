# PKDB-Bench: implicit_join instance
# For each Nobel Prize in Literature laureate from prize-years 2000 through 2024,
# list every notable work declared on the laureate's Wikidata item (P800),
# with the work's publication date (P577) where Wikidata has it.
#
# Universe (deterministic, source-reproducible):
#   - laureates: every entity with a P166 (award received) statement whose value
#     is Q37922 (Nobel Prize in Literature) and whose P585 (point in time)
#     qualifier falls in 2000-2024 inclusive
#   - works: every P800 (notable work) value declared on each laureate
#
# Per `references/sparql-gotchas.md`:
#   §1: P166/P585 use the all-ranks `p:` / `ps:` / `pq:` paths so the year-qualifier
#   filter is explicit rather than relying on rank curation. P800 uses `wdt:`
#   because its values are typically curated and we want truthy-rank notable
#   works.
#   §3: the wikibase:label SERVICE clause is at the end of the WHERE block.
#
# Post-processor responsibilities (documented in _extraction_notes):
#   - drop rows whose work label is an unresolved QID (e.g., "Q120560612"
#     for one Mo Yan work whose label service failed); these are Wikidata
#     data-completeness issues, not query bugs
#   - represent missing P577 with an explicit sentinel rather than empty
#     ("not specified"), matching the precedent set by
#     top_10_most_populous_cities_per_continent
#   - truncate P577 datetimes to a 4-digit year

SELECT ?laureate ?laureateLabel ?nobelYear ?work ?workLabel ?pubdate WHERE {
  ?laureate p:P166 ?awardStmt .
  ?awardStmt ps:P166 wd:Q37922 .
  ?awardStmt pq:P585 ?yearVal .
  BIND(YEAR(?yearVal) AS ?nobelYear)
  FILTER(?nobelYear >= 2000 && ?nobelYear <= 2024)

  ?laureate wdt:P800 ?work .
  OPTIONAL { ?work wdt:P577 ?pubdate . }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?nobelYear ?laureateLabel ?pubdate
