# PKDB-Bench: multi_hop instance
# For each landlocked country in Africa, list each bordering country and
# that bordering country's official language(s).
#
# Hops:
#   landlocked country (Q123480) in Africa (Q15)
#     -- shares border with (P47) --> neighbor (must be Q6256 country)
#     -- official language (P37) ----> language
#
# Note on the universe clause:
#   The landlocked-country side uses the all-ranks P31 path (`p:P31/ps:P31`)
#   instead of the truthy path (`wdt:P31`). Some Wikidata items (e.g., Rwanda,
#   Q1037) have multiple P31 statements where Q123480 ("landlocked country")
#   is recorded at normal rank rather than preferred rank, so the truthy path
#   would silently drop them. The all-ranks path captures every P31=Q123480
#   statement regardless of rank, which yields the full set of 16 landlocked
#   African countries.
#
#   Neighbor and official-language hops keep the truthy `wdt:` path, since for
#   those hops the canonical (preferred-rank) classification is what we want.
#
# Composite primary key in the output: (Landlocked Country, Bordering Country, Official Language)
SELECT DISTINCT ?landlockedLabel ?neighborLabel ?languageLabel WHERE {
  ?landlocked p:P31/ps:P31 wd:Q123480 .   # all-rank instance of: landlocked country
  ?landlocked wdt:P30 wd:Q15 .            # continent: Africa
  ?landlocked wdt:P47 ?neighbor .         # shares border with
  ?neighbor   wdt:P31 wd:Q6256 .          # neighbor must be a country
  ?neighbor   wdt:P37 ?language .         # neighbor's official language
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?landlockedLabel ?neighborLabel ?languageLabel
