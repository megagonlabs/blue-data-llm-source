# PKDB-Bench: set_filter instance
# Which sovereign states currently drive on the left side of the road,
# with their continent and population?
#
# Universe: every Wikidata sovereign state (P31 = Q3624078) with at least
# one currently-active driving-side claim equal to "left-hand traffic"
# (P1622 = Q11920728).
#
# Per `references/sparql-gotchas.md`:
#
#   §1: this query uses the all-ranks property path `p:P1622/ps:P1622`
#   rather than the truthy `wdt:P1622` shortcut, because some sovereign
#   states have multiple historical P1622 statements (e.g., Argentina's
#   pre-1945 left-hand-traffic statement, Sweden and Iceland's pre-Dagen-H
#   statements) that should be filtered out by their `pq:P582` end-time
#   qualifier rather than relying on rank curation alone. We then drop
#   deprecated-rank statements and statements that have an explicit end
#   time, leaving only currently-active "left-hand traffic" claims.
#
#   §3: the wikibase:label SERVICE clause is at the end of the WHERE block
#   so all variables are bound before labelling.
#
# Continent (P30) and population (P1082) are returned as OPTIONAL so a
# state with missing continent or population still appears as a row.
# Some Pacific island states have multiple P30 values (Oceania +
# Insular Oceania) — the post-processor picks one canonical continent
# label per row.

SELECT DISTINCT ?country ?countryLabel ?continent ?continentLabel ?population WHERE {
  ?country p:P1622 ?stmt .
  ?stmt ps:P1622 wd:Q11920728 .
  FILTER NOT EXISTS { ?stmt pq:P582 ?endTime }
  FILTER NOT EXISTS { ?stmt wikibase:rank wikibase:DeprecatedRank }

  ?country wdt:P31 wd:Q3624078 .

  OPTIONAL { ?country wdt:P30 ?continent . }
  OPTIONAL { ?country wdt:P1082 ?population . }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?countryLabel
