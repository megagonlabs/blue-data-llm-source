# PKDB-Bench: hierarchical_decomposition instance
# For each US state, list cities with population over 100,000.
#
# Wikidata model:
#   ?city wdt:P17 wd:Q30                    # country: USA
#   ?city wdt:P1082 ?population             # population (truthy = current canonical)
#   ?city wdt:P131 ?via . { ?via=?state } UNION { ?via wdt:P131 ?state }
#                                            # city directly in state, OR city → county → state
#   ?state wdt:P31 wd:Q35657                # state of the United States
#
# Performance note: earlier drafts used `wdt:P131+` (transitive) but the
# WDQS public endpoint timed out (504) because the transitive walk
# expanded across the full P131 graph before the population filter
# could narrow. The UNION below covers the two common US containment
# patterns: (a) city directly listed under a state, and (b) city listed
# under a county, which is itself listed under a state. Cities nested
# more than two hops deep (e.g., city → township → county → state)
# would be missed; this is acceptable for the scaled_enumeration
# proxy and is documented in curation.json::open_questions.
#
# Rank handling per references/sparql-gotchas.md: all hops use the
# truthy `wdt:` shortcut. Each is a canonical-attribute read; none is
# a universe-membership filter where the all-ranks Option B pattern
# would be needed.
SELECT DISTINCT ?stateLabel ?cityLabel ?population WHERE {
  ?city wdt:P17 wd:Q30 .
  ?city wdt:P1082 ?population .
  FILTER(?population > 100000)
  ?city wdt:P131 ?via .
  {
    BIND(?via AS ?state)
  } UNION {
    ?via wdt:P131 ?state .
  }
  ?state wdt:P31 wd:Q35657 .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?stateLabel DESC(?population)
